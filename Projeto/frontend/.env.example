# Copie este arquivo para .env.local e preencha com os dados do projeto Supabase
# (Supabase → Project Settings → API). O .env.local não vai para o GitHub.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# A chave secreta (service role) NUNCA vai no frontend nem com prefixo VITE_.
# Ela só é usada na Edge Function, configurada no painel do Supabase.
